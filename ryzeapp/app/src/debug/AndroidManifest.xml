<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the debug build only: adb hooks for testing without the watch (see debug/DebugEventReceiver).
     The receiver must be exported for `adb shell am broadcast`, so it is guarded with android.permission.DUMP:
     the shell user holds it, third-party apps cannot (signature|privileged|development), so no other app can
     ring the phone through this hook. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".debug.DebugEventReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="au.buzz.ryzewave.debug.FIND_PHONE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
