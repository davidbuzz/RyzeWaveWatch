<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a rounded watch outline (case + strap stubs) with a heart-rate wave inside.
  Everything sits inside the 66 dp safe circle of the 108 dp adaptive-icon canvas (centre 54,54, radius 33),
  so no launcher mask (circle, squircle, rounded square) clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- strap stubs -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,23.5 h12 a2.5,2.5 0 0 1 2.5,2.5 v5.5 h-17 v-5.5 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45.5,76.5 h17 v5.5 a2.5,2.5 0 0 1 -2.5,2.5 h-12 a2.5,2.5 0 0 1 -2.5,-2.5 z" />
    <!-- watch case: rounded rectangle, 36 x 42 dp, stroked -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M46,33 h16 a10,10 0 0 1 10,10 v22 a10,10 0 0 1 -10,10 h-16 a10,10 0 0 1 -10,-10 v-22 a10,10 0 0 1 10,-10 z" />
    <!-- crown -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M74,49 h2.5 a1,1 0 0 1 1,1 v8 a1,1 0 0 1 -1,1 h-2.5 z" />
    <!-- heart-rate wave -->
    <path
        android:strokeColor="#FFFF6B6B"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M40,54 h5.5 l3,-6 l4,13 l4,-19 l4,20 l3,-8 h6.5" />
</vector>
